# 배포용 환경 변수 예시
# EC2에서: cp .env.prod.example .env 후 값을 채우세요. (.env는 커밋 금지)

# ── 도메인 / 프론트엔드 ─────────────────────────
# CloudFront에 연결한 도메인 (프론트 빌드 시 wss://<DOMAIN>/ws 로 들어감)
DOMAIN=neco.example.com
# frontend 레포를 clone한 경로 (backend 기준 상대 경로)
FRONTEND_DIR=../neco-frontend

# ── Application ────────────────────────────────
PORT=8080
NODE_ENV=production

# ── PostgreSQL (compose 내부망에서만 접근) ──────
DB_USERNAME=postgres
DB_PASSWORD=change_me_strong_password
DB_NAME=neconaeco
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ── JWT ────────────────────────────────────────
# openssl rand -hex 32 로 생성
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── LLM ────────────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5_4-mini-2026-03-17
LLM_TIMEOUT_MS=60000

# ── Docker / Container Runtime ─────────────────
DOCKER_SOCKET=/var/run/docker.sock
RUNTIME_EXECUTION_TIMEOUT_MS=10000
RUNTIME_CONTAINER_CPUS=0.5
RUNTIME_CONTAINER_MEMORY=256m
